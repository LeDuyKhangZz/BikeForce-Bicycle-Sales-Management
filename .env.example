# ---------------------------------------------------------------------------
# BikeForce — mẫu biến môi trường
#
# File này CHỈ chứa TÊN BIẾN + PLACEHOLDER. Tuyệt đối không điền giá trị thật
# vào đây (NFR-005, AGENTS.md §8).
#
# Cách dùng: sao chép thành `.env.local` rồi điền giá trị thật.
#   PowerShell:  Copy-Item .env.example .env.local
# `.env.local` đã bị `.gitignore` chặn — không bao giờ commit.
# ---------------------------------------------------------------------------

# --- Public (được nhúng vào client bundle theo thiết kế) --------------------
# Lấy tại: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Lấy tại: Supabase Dashboard → Project Settings → API → Project API keys → anon / public
# Key này public-safe CHỈ VÌ RLS bật deny-by-default trên mọi bảng (DEC-004).
# Nếu ai đó tắt RLS trên một bảng, key này lập tức trở thành lỗ hổng.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-placeholder>

# URL gốc của site, dùng cho redirect auth và absolute URL trong Route Handler.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SECRET — SERVER ONLY --------------------------------------------------
# Lấy tại: Supabase Dashboard → Project Settings → API → Project API keys → service_role
#
# CẢNH BÁO: key này BYPASS TOÀN BỘ RLS.
#   • KHÔNG BAO GIỜ thêm prefix NEXT_PUBLIC_ cho biến này.
#   • Chỉ được đọc bởi `lib/supabase/admin.ts` và chỉ cho `auth.admin.*` (DEC-005).
#   • Trên Vercel: chỉ set ở scope server-side.
#   • Nếu nghi ngờ lộ: rotate key ngay, không chỉ xoá file.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-placeholder-SERVER-ONLY>

# --- SaleWork sync - SERVER/LOCAL ONLY ------------------------------------
# Token lấy từ Local Storage của https://zalo.salework.net sau khi đăng nhập.
# Không đặt prefix NEXT_PUBLIC_ và không commit giá trị thật.
SALEWORK_USER_TOKEN=<salework-user-token-placeholder>

# --- CHỈ DÙNG CHO TEST TRÊN MÁY LOCAL --------------------------------------
# Kết nối Postgres trực tiếp, dùng bởi `tests/integration/**` và `tests/rls/**`
# để dựng fixture (DEC-022, DEC-031). Ứng dụng KHÔNG đọc biến này và nó KHÔNG
# được đặt trên Vercel.
#
# Vì sao test không dùng service role: `service_role` có BYPASSRLS nhưng
# BYPASSRLS KHÔNG vượt qua GRANT, và migration cố ý không cấp DML cho nó trên
# `profiles` / `daily_reports` — nhờ vậy DEC-005 được database ép.
#
# Lấy giá trị đúng bằng `npx supabase status` (khoá DB_URL).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# HAI FILE ENV, HAI MỤC ĐÍCH — đọc kỹ trước khi điền giá trị cloud
#
#   .env.local        → ứng dụng: `npm run dev`, `npm run build`, `npm start`
#                       Sau Phase 2 file này trỏ vào Supabase CLOUD.
#
#   .env.test.local   → bộ test: `npm test`, `npm run test:db`
#                       LUÔN trỏ vào Supabase LOCAL. Vitest nạp file này SAU
#                       `.env.local` nên nó đè lên (xem `vitest.config.mts`).
#
# Vì sao phải tách: test tầng integration/RLS **xoá và ghi đè dữ liệu**. Nếu để
# chúng đọc `.env.local` sau khi file đó trỏ cloud thì một lần `npm test` là mất
# dữ liệu production. DEC-022 cấm test trên production, và đây là cách thực thi.
# `tests/integration/setup.ts` còn một chặn an toàn nữa: URL không phải
# localhost thì ném lỗi ngay.
#
# Cả hai file đều bị `.gitignore` chặn.
# ---------------------------------------------------------------------------
